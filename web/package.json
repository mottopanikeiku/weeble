{
  "name": "pushable-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "simplify": "node scripts/simplify-meshes.mjs",
    "record": "node scripts/record-demo.mjs",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "compare:scenes": "node --import tsx scripts/compare-scenes.ts",
    "parity:report": "PUSHABLE_PARITY_REPORT=../results/parity-checks/wasm.json npm test"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.183.0",
    "meshoptimizer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
